# ==================== 教务系统配置 ====================
# 从浏览器登录后获取的 Cookies（F12 -> Application -> Cookies）
COOKIE_JSESSIONID=你的JSESSIONID
COOKIE_ROUTE=你的route值

# 教务系统基础地址
BASE_URL=https://jwxt.shu.edu.cn/jwglxt

# ==================== 监控参数 ====================
CLASS_CAPACITY=30
CHECK_INTERVAL=30

# 学期参数（如果查不到课程，优先检查这里）
# XKXNM: 学年 2025 = 2025-2026学年
# XKXQM: 学期 12=秋季, 16=春季
XKXNM=2025
XKXQM=16

# ==================== 用户上下文参数 ====================
# 以下参数从浏览器请求中获取（通常不需要修改）
XH_ID=B1
JG_ID=01080000
ZYH_ID=20130809010052
ZYFX_ID=wfx
NJDM_ID=2024
BH_ID=20242013080901005201
